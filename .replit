modules = ["go-1.21", "web", "bash"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "GOTOOLCHAIN=local go build -o bin/gyds-litenode . && GYDS_RPC_PORT=8000 GYDS_LOG_LEVEL=info GYDS_LOG_FORMAT=pretty ./bin/gyds-litenode start"
waitForPort = 8000

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 30303
externalPort = 80

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "GYDS_RPC_PORT=8000 GYDS_LOG_LEVEL=info ./bin/gyds-litenode start"]
build = ["bash", "-c", "GOTOOLCHAIN=local go build -o bin/gyds-litenode ."]
